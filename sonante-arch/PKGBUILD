# Maintainer: Tiago Alam <tiagoalam@protonmail.com>
pkgname=sonante
pkgver=0.5.7
pkgrel=1
pkgdesc="Linux desktop audio player for local and Plex libraries"
arch=('x86_64')
url="https://github.com/tiagoalam/sonante"
license=('GPL-3.0-only')
depends=(
    'alsa-lib'
    'alsa-utils'
    'gtk3'
    'mpd'
    'openssl'
    'webkit2gtk-4.1'
    'xdg-utils'
    'xdg-desktop-portal'
)
makedepends=('git' 'npm' 'rust')
optdepends=(
    'libappindicator: optional system tray indicator'
    'webp-pixbuf-loader: display WebP sidecar album covers'
    'wireplumber: control Shared volume through PipeWire using wpctl'
    'xdg-desktop-portal-gtk: GTK file chooser when no desktop portal backend is installed'
)
conflicts=('sonante-bin')
options=('!debug')
source=(
    "git+${url}.git#tag=v${pkgver}"
    'sonante.desktop'
)
sha256sums=(
    'SKIP'
    'cce035916bf8c0ed3adf41095d0f4f77b9043fdbd8cbbdd96c58a44b3fb997bb'
)

build() {
    cd "${srcdir}/sonante"
    npm ci
    npm run tauri -- build --no-bundle -- --locked
}

package() {
    cd "${srcdir}/sonante"

    install -Dm755 'src-tauri/target/release/sonante' "${pkgdir}/usr/bin/sonante"
    install -Dm644 "${srcdir}/sonante.desktop" \
        "${pkgdir}/usr/share/applications/sonante.desktop"
    install -Dm644 'src-tauri/icons/32x32.png' \
        "${pkgdir}/usr/share/icons/hicolor/32x32/apps/sonante.png"
    install -Dm644 'src-tauri/icons/128x128.png' \
        "${pkgdir}/usr/share/icons/hicolor/128x128/apps/sonante.png"
    install -Dm644 'src-tauri/icons/128x128@2x.png' \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/sonante.png"
    install -Dm644 'src-tauri/icons/icon.png' \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/sonante.png"
    install -Dm644 'LICENSE' "${pkgdir}/usr/share/licenses/sonante/LICENSE"
    install -Dm644 'AUTHORS' "${pkgdir}/usr/share/doc/sonante/AUTHORS"
    install -Dm644 'THIRD_PARTY_NOTICES' "${pkgdir}/usr/share/doc/sonante/THIRD_PARTY_NOTICES"
    install -Dm644 'README.md' "${pkgdir}/usr/share/doc/sonante/README.md"
}
