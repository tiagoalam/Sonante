{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonante",
  "version": "0.4.9",
  "identifier": "com.sonante.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
	{
        "title": "Sonante",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
  "active": true,
  "targets": ["deb", "rpm"],
  "shortDescription": "Linux desktop audio player for local and Plex libraries",
  "license": "LicenseRef-Proprietary",
  "category": "Music",
  "homepage": "https://github.com/tiagoalam/Sonante",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "linux": {
    "deb": {
      "recommends": ["xdg-desktop-portal-gtk", "webp-pixbuf-loader"],
      "depends": [
        "mpd",
        "libasound2",
        "alsa-utils",
        "libssl3",
        "xdg-utils",
        "xdg-desktop-portal"
      ]
    },
    "rpm": {
      "recommends": ["xdg-desktop-portal-gtk", "webp-pixbuf-loader"],
      "release": "1",
      "depends": [
        "mpd",
        "alsa-lib",
        "alsa-utils",
        "gtk3",
        "webkit2gtk4.1",
        "openssl-libs",
        "xdg-utils",
        "xdg-desktop-portal"
      ]
    }
  }
}
}
