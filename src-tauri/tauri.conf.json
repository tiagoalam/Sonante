{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonante",
  "version": "0.5.3",
  "identifier": "com.sonante.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
	{
        "title": "Sonante",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
  "active": true,
  "targets": ["deb", "rpm"],
  "shortDescription": "Linux desktop audio player for local and Plex libraries",
  "license": "GPL-3.0-only",
  "licenseFile": "../LICENSE",
  "copyright": "Copyright 2026 Tiago Alam",
  "category": "Music",
  "homepage": "https://github.com/tiagoalam/Sonante",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "linux": {
    "deb": {
      "files": {
        "/usr/share/doc/sonante/LICENSE": "../LICENSE",
        "/usr/share/doc/sonante/AUTHORS": "../AUTHORS",
        "/usr/share/doc/sonante/THIRD_PARTY_NOTICES": "../THIRD_PARTY_NOTICES",
        "/usr/share/doc/sonante/copyright": "../packaging/debian-copyright"
      },
      "recommends": ["xdg-desktop-portal-gtk", "webp-pixbuf-loader", "libayatana-appindicator3-1"],
      "depends": [
        "mpd",
        "libasound2",
        "alsa-utils",
        "libssl3",
        "libwebkit2gtk-4.1-0 (>= 2.40)",
        "xdg-utils",
        "xdg-desktop-portal"
      ]
    },
    "rpm": {
      "files": {
        "/usr/share/licenses/sonante/LICENSE": "../LICENSE",
        "/usr/share/doc/sonante/AUTHORS": "../AUTHORS",
        "/usr/share/doc/sonante/THIRD_PARTY_NOTICES": "../THIRD_PARTY_NOTICES"
      },
      "recommends": ["xdg-desktop-portal-gtk", "webp-pixbuf-loader", "libappindicator-gtk3"],
      "release": "1",
      "depends": [
        "mpd",
        "alsa-lib",
        "alsa-utils",
        "gtk3",
        "(webkit2gtk4.1 >= 2.40)",
        "openssl-libs",
        "xdg-utils",
        "xdg-desktop-portal"
      ]
    }
  }
}
}
