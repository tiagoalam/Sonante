+// SPDX-License-Identifier: GPL-3.0-only OR MPL-2.0
+//! Windows render I/O only: whole-frame FIFO, bounded drain and explicit
+//! failure. No DSP/filter/sample conversion or device-format negotiation.
+use std::collections::VecDeque;
+
+pub type Result<T> = std::result::Result<T, &'static str>;
+pub enum Notice { Data(usize), Drain, Stop, Empty }
+pub enum Outcome { Stopped, Drained }
+pub trait Source {
+    fn next(&mut self) -> Result<Notice>;
+    fn append(&mut self, bytes:usize, queue:&mut VecDeque<u8>) -> Result<()>;
+    fn pending_bytes(&self) -> usize;
+    fn pending_notices(&self) -> usize;
+    fn buffer_level(&self, frames:usize);
+    fn drained(&mut self) -> Result<()>;
+}
+pub trait Device {
+    fn capacity(&self) -> Result<usize>;
+    fn free(&self) -> Result<usize>;
+    fn padding(&self) -> Result<usize>;
+    fn submit(&mut self,frames:usize,queue:&mut VecDeque<u8>) -> Result<()>;
+    fn start(&mut self) -> Result<()>;
+    fn stop(&mut self) -> Result<()>;
+    fn wait(&mut self,max_ms:u32) -> Result<()>;
+    fn millis(&self) -> u64;
+}
+pub struct Config { pub blockalign:usize,pub chunksize:usize,pub target:usize }
+const DRAIN_MS:u64=2000;
+pub fn wait_for_capacity(required:usize,mut space:impl FnMut()->usize,mut millis:impl FnMut()->u64,mut wait:impl FnMut())->Result<()>{
+    let deadline=millis().checked_add(250).ok_or("SONANTE_WASAPI_BACKPRESSURE")?;
+    loop{
+        if millis()>=deadline{return Err("SONANTE_WASAPI_BACKPRESSURE");}
+        if space()>=required{return Ok(());}
+        wait();
+    }
+}
+
+pub fn run(device:&mut impl Device,source:&mut impl Source,c:Config)->Result<Outcome>{
+    let result=inner(device,source,c);
+    // Failure never publishes Done or retries a partially submitted block.
+    if result.is_err(){let _=device.stop();}
+    result
+}
+fn inner(device:&mut impl Device,source:&mut impl Source,c:Config)->Result<Outcome>{
+    if !(1..=256).contains(&c.blockalign)||c.chunksize==0||c.chunksize>65536||c.target>131072{return Err("SONANTE_WASAPI_FORMAT");}
+    let capacity=device.capacity()?;
+    if capacity==0||capacity>131072{return Err("SONANTE_WASAPI_BUFFER");}
+    let max_frames=c.chunksize.checked_add(capacity.checked_mul(2).ok_or("SONANTE_WASAPI_BUFFER")?).and_then(|v|v.checked_mul(4)).and_then(|v|v.checked_add(c.target)).ok_or("SONANTE_WASAPI_BUFFER")?;
+    let max_bytes=max_frames.checked_mul(c.blockalign).filter(|v|*v<=8*1024*1024).ok_or("SONANTE_WASAPI_BUFFER")?;
+    let chunk_bytes=c.chunksize.checked_mul(c.blockalign).ok_or("SONANTE_WASAPI_FORMAT")?;
+    let mut queue=VecDeque::with_capacity(max_bytes);
+    let mut running=false;
+    let mut drain_end=None;
+    let mut pending_data=None;
+    let mut last_progress=device.millis();
+    device.start()?;
+    loop{
+        let free=device.free()?;
+        if free>capacity{return Err("SONANTE_WASAPI_BUFFER");}
+        if let Some(end)=drain_end {
+            if device.millis()>=end{return Err("SONANTE_WASAPI_DRAIN_TIMEOUT");}
+            match source.next()? {
+                Notice::Stop=>{device.stop()?;return Ok(Outcome::Stopped)},
+                Notice::Empty=>{},
+                _=>return Err("SONANTE_WASAPI_AFTER_EOF"),
+            }
+        }
+        while drain_end.is_none() {
+            let notice=match pending_data.take(){Some(bytes)=>Notice::Data(bytes),None=>source.next()?};
+            match notice {
+                Notice::Data(bytes)=>{
+                    if bytes==0||bytes>chunk_bytes||bytes%c.blockalign!=0{return Err("SONANTE_WASAPI_FRAME_ALIGNMENT");}
+                    // Look ahead for control even when the device is full, but
+                    // leave data in the source ring until there is queue room.
+                    if running&&queue.len()>=free*c.blockalign{pending_data=Some(bytes);break;}
+                    let silence=if running{0}else{c.target*c.blockalign};
+                    if queue.len().checked_add(silence).and_then(|n|n.checked_add(bytes)).is_none_or(|n|n>max_bytes){return Err("SONANTE_WASAPI_BUFFER");}
+                    // Preserve Camilla's target-delay behavior on underrun.
+                    if !running {queue.extend(std::iter::repeat_n(0,silence));running=true;}
+                    let before=queue.len();source.append(bytes,&mut queue)?;
+                    if queue.len()!=before+bytes{return Err("SONANTE_WASAPI_SHORT_DATA");}
+                },
+                Notice::Drain=>{drain_end=Some(device.millis().checked_add(DRAIN_MS).ok_or("SONANTE_WASAPI_DRAIN_TIMEOUT")?);},
+                Notice::Stop=>{device.stop()?;return Ok(Outcome::Stopped)},
+                Notice::Empty=>{
+                    if queue.len()<free*c.blockalign{queue.resize(free*c.blockalign,0);running=false;}
+                    break;
+                },
+            }
+        }
+        let frames=if drain_end.is_some(){free.min(queue.len()/c.blockalign)}else{free};
+        if frames>0 {
+            let before=queue.len();device.submit(frames,&mut queue)?;
+            if queue.len()!=before-frames*c.blockalign{return Err("SONANTE_WASAPI_WRITE_UNCONFIRMED");}
+            last_progress=device.millis();
+        }
+        source.buffer_level(queue.len()/c.blockalign+source.pending_notices()*c.chunksize);
+        if let Some(end)=drain_end {
+            if queue.is_empty() {
+                match source.next()? {
+                    Notice::Stop=>{device.stop()?;return Ok(Outcome::Stopped)},
+                    Notice::Empty=>{},
+                    _=>return Err("SONANTE_WASAPI_AFTER_EOF"),
+                }
+                if source.pending_bytes()!=0||source.pending_notices()!=0{return Err("SONANTE_WASAPI_EOF_TAIL");}
+                if device.padding()?==0 {
+                    device.stop()?;source.drained()?;return Ok(Outcome::Drained);
+                }
+            }
+            let left=end.saturating_sub(device.millis());
+            if left==0{return Err("SONANTE_WASAPI_DRAIN_TIMEOUT");}
+            device.wait(left.min(1000)as u32)?;
+        }else if pending_data.is_some(){
+            let elapsed=device.millis().saturating_sub(last_progress);
+            if elapsed>=250{return Err("SONANTE_WASAPI_BACKPRESSURE");}
+            device.wait((250-elapsed).min(1000)as u32)?;
+        }else{device.wait(1000)?;}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    struct Feed{data:VecDeque<u8>,notices:VecDeque<Notice>,done:bool,short:bool}
+    impl Source for Feed {
+        fn next(&mut self)->Result<Notice>{Ok(self.notices.pop_front().unwrap_or(Notice::Empty))}
+        fn append(&mut self,bytes:usize,queue:&mut VecDeque<u8>)->Result<()>{queue.extend(self.data.drain(..bytes-usize::from(self.short)));Ok(())}
+        fn pending_bytes(&self)->usize{self.data.len()}
+        fn pending_notices(&self)->usize{self.notices.len()}
+        fn buffer_level(&self,_:usize){}
+        fn drained(&mut self)->Result<()>{self.done=true;Ok(())}
+    }
+    struct Sink{align:usize,capacity:usize,pending:VecDeque<u8>,heard:Vec<u8>,time:u64,stuck:bool,stopped:bool,fail_write:bool}
+    impl Device for Sink {
+        fn capacity(&self)->Result<usize>{Ok(self.capacity)}
+        fn free(&self)->Result<usize>{Ok(self.capacity-self.pending.len()/self.align)}
+        fn padding(&self)->Result<usize>{Ok(self.pending.len()/self.align)}
+        fn submit(&mut self,frames:usize,queue:&mut VecDeque<u8>)->Result<()>{if self.fail_write{return Err("fixture_write_failed");}self.pending.extend(queue.drain(..frames*self.align));Ok(())}
+        fn start(&mut self)->Result<()>{Ok(())}
+        fn stop(&mut self)->Result<()>{self.stopped=true;Ok(())}
+        fn wait(&mut self,_:u32)->Result<()>{self.time+=1;if !self.stuck{self.heard.extend(self.pending.drain(..));}Ok(())}
+        fn millis(&self)->u64{self.time}
+    }
+    fn fixture(frames:usize,chunk:usize,target:usize)->(Feed,Sink,Vec<u8>,Config){
+        let bytes=(0..frames*8).map(|n|(n%251+1)as u8).collect::<Vec<_>>();
+        let mut notices=VecDeque::new();let mut left=frames;
+        while left>0{let n=left.min(chunk);notices.push_back(Notice::Data(n*8));left-=n;}
+        notices.push_back(Notice::Drain);
+        (Feed{data:bytes.clone().into(),notices,done:false,short:false},Sink{align:8,capacity:257,pending:VecDeque::new(),heard:Vec::new(),time:0,stuck:false,stopped:false,fail_write:false},bytes,Config{blockalign:8,chunksize:chunk,target})
+    }
