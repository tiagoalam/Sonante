+        let(mut f,mut s,_,c)=fixture(17,1024,0);f.short=true;assert!(matches!(run(&mut s,&mut f,c),Err("SONANTE_WASAPI_SHORT_DATA")));assert!(!f.done);
+        let(mut f,mut s,_,c)=fixture(17,1024,0);s.fail_write=true;assert!(run(&mut s,&mut f,c).is_err());assert!(!f.done);
+        let(mut f,mut s,_,c)=fixture(17,1024,0);f.notices.push_back(Notice::Data(8));assert!(run(&mut s,&mut f,c).is_err());assert!(!f.done);
+    }
+    #[test]
+    fn stop_during_drain_is_cancellation_not_a_done_ack(){
