+            let(mut feed,mut sink,bytes,c)=fixture(frames,chunk,target);
+            assert!(matches!(run(&mut sink,&mut feed,c),Ok(Outcome::Drained)));
+            let mut expected=vec![0;target*8];expected.extend(bytes);
+            assert_eq!(sink.heard,expected);assert!(sink.pending.is_empty());assert!(feed.done&&sink.stopped);
+        }
+    }
