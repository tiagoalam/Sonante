+// SPDX-License-Identifier: GPL-3.0-only OR MPL-2.0
+//! Sonante Windows input adapter only. DSP, conversion and processing unchanged.
+#[path="pcm_core.rs"]mod core;
+use crate::config::BinarySampleFormat;
+use serde::{Deserialize,Serialize};
+use std::{ffi::c_void,io::{self,Read},ptr::null_mut};
+type Handle=*mut c_void;
+#[link(name="kernel32")]
+unsafe extern "system" {
+ fn MapViewOfFile(mapping:Handle,access:u32,high:u32,low:u32,bytes:usize)->*mut c_void;
+ fn UnmapViewOfFile(address:*const c_void)->i32;
+ fn CloseHandle(handle:Handle)->i32;
+ fn GetHandleInformation(handle:Handle,flags:*mut u32)->i32;
+ fn SetHandleInformation(handle:Handle,mask:u32,flags:u32)->i32;
+ fn SetEvent(handle:Handle)->i32;
+ fn WaitForMultipleObjects(count:u32,handles:*const Handle,all:i32,millis:u32)->u32;
+}
+#[derive(Clone,Debug,Serialize,Deserialize,Eq,PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Parameters {
+ pub mapping:String,pub readable:String,pub writable:String,pub stop:String,
+ pub owner_pid:u32,pub nonce0:String,pub nonce1:String,
+}
+pub struct CaptureFormat {
+ pub rate:usize,pub capture_rate:usize,pub channels:usize,pub format:BinarySampleFormat,
+ pub transformed:bool,
+}
+fn failure(code:&'static str)->io::Error{io::Error::new(io::ErrorKind::Other,code)}
+fn number(text:&str)->io::Result<u64>{
+ if text.is_empty()||text.len()>20||!text.bytes().all(|b|b.is_ascii_digit()){return Err(failure("SONANTE_PCM_BINDING"));}
+ text.parse().map_err(|_|failure("SONANTE_PCM_BINDING"))
+}
+struct Inputs([Handle;4]);
+impl Drop for Inputs {fn drop(&mut self){for h in self.0 {unsafe{CloseHandle(h)};}}}
+struct View(*mut c_void);
+impl Drop for View {fn drop(&mut self){if !self.0.is_null(){unsafe{UnmapViewOfFile(self.0)};}}}
+pub struct RingStream {reader:core::Reader,_view:View,inputs:Inputs}
+// Handles/views are process resources; ownership moves once into capture thread.
+unsafe impl Send for RingStream {}
+impl RingStream {
+ pub fn new(p:Parameters,f:CaptureFormat)->io::Result<Self>{
+  const _:()=assert!(size_of::<usize>()==8);
+  if f.rate!=48000||f.capture_rate!=48000||f.channels!=2||f.format!=BinarySampleFormat::S32_LE||f.transformed{return Err(failure("SONANTE_PCM_FORMAT"));}
+  let mut raw=[null_mut();4];
+  for (i,s) in [&p.mapping,&p.readable,&p.writable,&p.stop].into_iter().enumerate(){
+   let v=number(s)?;if v==0||v>isize::MAX as u64{return Err(failure("SONANTE_PCM_BINDING"));}
+   raw[i]=v as usize as Handle;if raw[..i].contains(&raw[i]){return Err(failure("SONANTE_PCM_BINDING"));}
+  }
+  let binding=core::Binding{owner:p.owner_pid,nonce0:number(&p.nonce0)?,nonce1:number(&p.nonce1)?};
+  let inputs=Inputs(raw);
+  for h in raw {let mut flags=0;if unsafe{GetHandleInformation(h,&mut flags)}==0||unsafe{SetHandleInformation(h,1,0)}==0{return Err(failure("SONANTE_PCM_BINDING"));}}
+  let view=View(unsafe{MapViewOfFile(raw[0],0x000f001f,0,0,size_of::<core::Header>())});
+  let reader=unsafe{core::Reader::new(view.0.cast(),binding)}.map_err(|_|failure("SONANTE_PCM_BINDING"))?;
+  reader.claim().map_err(|_|failure("SONANTE_PCM_ALREADY_CLAIMED"))?;
+  Ok(Self{reader,_view:view,inputs})
+ }
+}
+impl Read for RingStream {
+ fn read(&mut self,out:&mut[u8])->io::Result<usize>{
+  loop {
+   match self.reader.read(out).map_err(|_|failure("SONANTE_PCM_CONTINUITY"))? {
+    Some(n)=>{if n>0&&unsafe{SetEvent(self.inputs.0[2])}==0{return Err(failure("SONANTE_PCM_SIGNAL"));}return Ok(n)},
+    None=>{},
+   }
+   let handles=[self.inputs.0[3],self.inputs.0[1]];
+   match unsafe{WaitForMultipleObjects(2,handles.as_ptr(),0,u32::MAX)} {
+    0=>{let flags=self.reader.flags().map_err(|_|failure("SONANTE_PCM_BINDING"))?;
+        if flags&core::LOST!=0{return Err(failure("SONANTE_PCM_CONTINUITY"));}
+        if flags&core::STOP!=0{return Ok(0);}
+        return Err(failure("SONANTE_PCM_STOP_UNCONFIRMED"));},
+    1=>{},
+    _=>return Err(failure("SONANTE_PCM_WAIT")),
+   }
+  }
+ }
+}
+impl Drop for RingStream {
+ fn drop(&mut self){
+  // Capture-thread failure/config restart is visible even while MPD is paused
+  // and no GUI status polling occurs. Never leave a consumerless live channel.
+  match self.reader.flags(){
+   Ok(flags) if flags&(core::EOF|core::STOP)!=0=>{},
+   _=>{
+    self.reader.invalidate();
+    for h in &self.inputs.0[1..]{unsafe{SetEvent(*h)};}
+   },
+  }
+ }
+}
