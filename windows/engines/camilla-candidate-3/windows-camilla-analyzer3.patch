+    pub fn stop(&mut self, app: Option<&AppHandle>) -> Result<(), String> {
+        let Some(controller_stop) = self.controller_stop.take() else {
+            if let Some(app) = app {
+                if let Some(owner) = self.event_owner() {
+                    emit_status(app, &owner, false, Some("stopped"));
+                }
+            }
+            return Ok(());
+        };
