+ }
+}
+fn global()->&'static Arc<Shared>{static STATE:OnceLock<Arc<Shared>>=OnceLock::new();STATE.get_or_init(Shared::new)}
+pub fn request(request:Request)->Result<Response,&'static str>{global().request(request)}
+pub(super) struct Capture{shared:Arc<Shared>,id:u64,live:Arc<AtomicBool>}
+impl Capture{
+ pub(super) fn attach(owner:u32,nonce0:u64,nonce1:u64)->Option<Self>{global().attach(SourceKey{owner,nonce0,nonce1})}
+ /// Audio capture calls only this bounded, nonblocking/no-allocation method.
+ pub(super) fn offer(&self,bytes:&[u8]){
+  let epoch=self.shared.active_epoch.load(Ordering::Acquire);if epoch==0||!self.live.load(Ordering::Acquire)||bytes.len()%8!=0||bytes.len()>4096*8{return;}
+  let Ok(mut ingress)=self.shared.ingress.try_lock()else{return;};if ingress.source!=self.id||ingress.epoch!=epoch{return;}
+  for frame in bytes.chunks_exact(8){
+   if self.shared.active_epoch.load(Ordering::Acquire)!=epoch||!self.live.load(Ordering::Acquire){return;}
