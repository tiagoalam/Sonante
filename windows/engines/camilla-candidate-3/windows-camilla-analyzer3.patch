+            assert_eq!(analyzer.borrow().is_active(), invalidation == "new_capture");
+            assert!(
+                !new_stop.load(Ordering::Acquire),
+                "must not stop a newer capture"
+            );
+            analyzer.borrow_mut().controller_stop = None;
+        }
