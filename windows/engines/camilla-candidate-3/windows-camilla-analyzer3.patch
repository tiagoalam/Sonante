+   }
+  }
+  if self.poisoned.load(Ordering::Acquire){return Err("SONANTE_ANALYZER_UNAVAILABLE");}
+  let latest=self.latest.lock().map_err(|_|"SONANTE_ANALYZER_UNAVAILABLE")?;
