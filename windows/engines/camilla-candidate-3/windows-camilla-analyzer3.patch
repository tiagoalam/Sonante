+#[derive(Clone,Deserialize,Serialize,PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Request{pub version:u8,pub owner_pid:u32,pub nonce0:String,pub nonce1:String,pub epoch:u64,pub token:String,pub action:Action}
+impl fmt::Debug for Request{fn fmt(&self,f:&mut fmt::Formatter<'_>)->fmt::Result{f.debug_struct("SonanteAnalyzerRequest").field("version",&self.version).field("action",&self.action).field("epoch",&self.epoch).finish_non_exhaustive()}}
+#[derive(Serialize,PartialEq)]
+pub struct Response{pub version:u8,pub available:bool,pub epoch:u64,pub token:String,pub sequence:u64,pub age_ms:u64,pub frame:Option<AudioLevelFrame>}
+impl fmt::Debug for Response{fn fmt(&self,f:&mut fmt::Formatter<'_>)->fmt::Result{f.debug_struct("SonanteAnalyzerResponse").field("version",&self.version).field("available",&self.available).field("epoch",&self.epoch).field("sequence",&self.sequence).finish_non_exhaustive()}}
