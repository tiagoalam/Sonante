+impl Default for Ingress{fn default()->Self{Self{source:0,epoch:0,filled:0,sequence:0,bytes:[0;BYTES]}}}
+struct Packet{source:u64,epoch:u64,sequence:u64,live:Arc<AtomicBool>,captured:Instant,bytes:[u8;BYTES]}
+struct Latest{source:u64,epoch:u64,sequence:u64,live:Arc<AtomicBool>,captured:Instant,frame:AudioLevelFrame}
