+    }
+    let position = (frequency / SPECTRUM_MIN_HZ).ln() / (SPECTRUM_MAX_HZ / SPECTRUM_MIN_HZ).ln();
+    Some(((position * SPECTRUM_BANDS as f32).floor() as usize).min(SPECTRUM_BANDS - 1))
+}
