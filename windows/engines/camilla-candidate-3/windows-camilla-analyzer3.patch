+impl Shared{
+ fn new()->Arc<Self>{Arc::new(Self{control:Mutex::new(Control::default()),capture_id:AtomicU64::new(0),active_epoch:AtomicU64::new(0),ingress:Mutex::new(Ingress::default()),pending:Mutex::new(None),changed:Condvar::new(),latest:Mutex::new(None),worker_started:AtomicBool::new(false),poisoned:AtomicBool::new(false)})}
